{
  "schema_version": "1.0",
  "skill_name": "surface-modeling",
  "schema_type": "task_parameter_schema",
  "tasks": {
    "slab_generation": {
      "script": "genkai.modeling.surface.slab:main",
      "ptomodel_mapping_role": "bulk-to-slab surface construction input",
      "parameters": {
        "bulk": { "type": "path", "required": false, "description": "Bulk crystal file; one of bulk, formula, material_id" },
        "formula": { "type": "string", "required": false, "description": "Materials Project formula for the bulk reference" },
        "material_id": { "type": "string", "required": false },
        "facet": { "type": "string", "required": false, "description": "Miller index in the conventional cell, e.g. (111)" },
        "max_index": { "type": "int", "required": false },
        "calculator": { "type": "enum", "required": false, "choices": ["none", "emt", "uma"] },
        "uma_model": { "type": "string", "required": false },
        "task_name": { "type": "string", "required": false, "description": "FAIRChem UMA task head such as omat or oc20; not the PToModel task key" },
        "device": { "type": "enum", "required": false, "choices": ["cuda", "cpu"] },
        "relax_steps": { "type": "int", "required": false },
        "fmax": { "type": "float", "required": false },
        "min_slab_size": { "type": "float", "required": false },
        "min_vacuum_size": { "type": "float", "required": false },
        "min_lateral_size": { "type": "float", "required": false },
        "repeat_xy": { "type": "string", "required": false },
        "fixed_fraction": { "type": "float", "required": false },
        "fixed_layers": { "type": "int", "required": false },
        "output_dir": { "type": "path", "required": false },
        "prefix": { "type": "string", "required": false }
      },
      "constraints": [
        "exactly one of bulk, formula, material_id must be provided",
        "the bulk is converted to the conventional standard cell before Miller indices are applied",
        "without facet, calculator='none' uses the reviewed stable-facet registry and stops when no entry exists",
        "calculator in ['emt', 'uma'] ranks facets up to max_index by surface energy (Wulff area fraction)",
        "0 <= fixed_fraction < 1"
      ]
    },
    "vacancy_landscape": {
      "script": "genkai.modeling.surface.vacancy:main",
      "ptomodel_mapping_role": "oxide surface vacancy modeling input",
      "parameters": {
        "input": { "type": "path", "required": true },
        "output_dir": { "type": "path", "required": false },
        "structure_prefix": { "type": "string", "required": false },
        "vacancy_counts": { "type": "comma_separated_ints", "required": false },
        "samples_per_count": { "type": "int", "required": false },
        "mu_o": { "type": "float", "required": false },
        "z_frac_min": { "type": "float", "required": false },
        "z_frac_max": { "type": "float", "required": false },
        "calculator": { "type": "enum", "required": false, "choices": ["uma", "none"] },
        "smoke_test": { "type": "bool", "required": false },
        "uma_model": { "type": "string", "required": false },
        "device": { "type": "enum", "required": false, "choices": ["cuda", "cpu"] },
        "task_name": { "type": "string", "required": false, "description": "FAIRChem UMA task head such as omat or oc20; not the PToModel task key" },
        "include_d3": { "type": "bool", "required": false },
        "fmax": { "type": "float", "required": false },
        "max_steps": { "type": "int", "required": false },
        "seed": { "type": "int", "required": false },
        "write_all_structures": { "type": "bool", "required": false }
      },
      "constraints": [
        "samples_per_count >= 1",
        "0 <= z_frac_min <= z_frac_max <= 1",
        "calculator in ['uma', 'none']",
        "calculator='uma' requires uma_model and device"
      ]
    },
    "adsorbate_landscape": {
      "script": "genkai.modeling.surface.adsorbate:main",
      "ptomodel_mapping_role": "surface adsorbate coverage modeling input",
      "parameters": {
        "surface": { "type": "path", "required": true },
        "molecule": { "type": "path", "required": true },
        "output_dir": { "type": "path", "required": false },
        "structure_prefix": { "type": "string", "required": false },
        "site_symbols": { "type": "string", "required": false },
        "site_z_tolerance": { "type": "float", "required": false },
        "max_sites": { "type": "int", "required": false },
        "site_group_size": { "type": "int", "required": false },
        "n_trials_single": { "type": "int", "required": false },
        "site_radius": { "type": "float", "required": false },
        "z_gap_min": { "type": "float", "required": false },
        "z_gap_max": { "type": "float", "required": false },
        "coverage_counts": { "type": "comma_separated_ints", "required": false },
        "patterns": { "type": "comma_separated_strings", "required": false },
        "random_repeats": { "type": "int", "required": false },
        "seed": { "type": "int", "required": false },
        "calculator": { "type": "enum", "required": false, "choices": ["uma", "none"] },
        "uma_model": { "type": "string", "required": false },
        "device": { "type": "enum", "required": false, "choices": ["cuda", "cpu"] },
        "task_name": { "type": "string", "required": false, "description": "FAIRChem UMA task head such as omat or oc20; not the PToModel task key" },
        "include_d3": { "type": "bool", "required": false },
        "fmax": { "type": "float", "required": false },
        "max_steps": { "type": "int", "required": false },
        "smoke_test": { "type": "bool", "required": false }
      },
      "constraints": [
        "site_group_size >= 1",
        "coverage_counts values must be within the computed max_adsorbates range",
        "patterns must be drawn from uniform, clustered, stripe, island, random",
        "calculator in ['uma', 'none']"
      ]
    },
    "surface_cluster_builder": {
      "script": "genkai.modeling.surface.metal_cluster.surface_cluster_builder:main",
      "ptomodel_mapping_role": "supported cluster species or loaded nanoparticle modeling input",
      "parameters": {
        "surface": { "type": "path", "required": false },
        "surface_formula": { "type": "string", "required": false },
        "surface_mp_id": { "type": "string", "required": false },
        "surface_facet": { "type": "miller_index", "required": false },
        "slab_min_size": { "type": "float", "required": false },
        "slab_vacuum": { "type": "float", "required": false },
        "slab_repeat_xy": { "type": "comma_separated_ints", "required": false },
        "cluster_element": { "type": "string", "required": false },
        "cluster_bulk_file": { "type": "path", "required": false },
        "cluster_from_mp": { "type": "bool", "required": false },
        "cluster_mp_id": { "type": "string", "required": false },
        "cluster_structures": {
          "type": "string_list",
          "required": false,
          "choices": ["fcc", "hcp", "bcc"]
        },
        "cluster_atoms": { "type": "int", "required": false },
        "cluster_layers": { "type": "int", "required": false },
        "cluster_radius": { "type": "float", "required": false },
        "stack_layers": { "type": "int", "required": false },
        "bcc_rows": { "type": "int", "required": false },
        "bcc_max_row_atoms": { "type": "int", "required": false },
        "cluster_a": { "type": "float", "required": false },
        "cluster_c": { "type": "float", "required": false },
        "fcc_rows": { "type": "comma_separated_ints", "required": false },
        "fcc_row_profile": {
          "type": "enum",
          "required": false,
          "choices": ["auto", "custom", "triangle", "hexagon", "trapezoid", "rectangle"]
        },
        "fcc_max_row_atoms": { "type": "int", "required": false },
        "fcc_row_count": { "type": "int", "required": false },
        "fcc_stacking_mode": { "type": "enum", "required": false, "choices": ["ABC", "AB"] },
        "fcc_layers": { "type": "int", "required": false },
        "hcp_rows": { "type": "comma_separated_ints", "required": false },
        "hcp_layers": { "type": "int", "required": false },
        "x_frac": { "type": "float", "required": false },
        "y_frac": { "type": "float", "required": false },
        "z_height": { "type": "float", "required": false },
        "phi": { "type": "float", "required": false },
        "theta": { "type": "float", "required": false },
        "psi": { "type": "float", "required": false },
        "output_dir": { "type": "path", "required": false }
      },
      "constraints": [
        "use at most one of surface, surface_formula, surface_mp_id",
        "surface loading requires a slab with a vacuum gap; bulk unit cells are rejected",
        "surface_formula or surface_mp_id requires MP_API_KEY and a resolved stable facet",
        "cluster_element and cluster_bulk_file should provide enough information to resolve a metal species",
        "in generic mode exactly one of cluster_atoms, cluster_layers, cluster_radius should be provided",
        "bcc bridge mode requires bcc_rows, bcc_max_row_atoms, stack_layers",
        "fcc row mode requires fcc_layers plus fcc_rows or an inferable fcc_row_profile setup",
        "hcp row mode requires hcp_rows"
      ]
    },
    "surface_cluster_mlip_search": {
      "script": "genkai.modeling.surface.cluster_search:main",
      "ptomodel_mapping_role": "surface-plus-prebuilt-cluster adsorption search input",
      "parameters": {
        "surface": { "type": "path", "required": true },
        "cluster": { "type": "path", "required": true },
        "output_dir": { "type": "path", "required": false },
        "n_trials": { "type": "int", "required": false },
        "fmax": { "type": "float", "required": false },
        "uma_model": { "type": "string", "required": false },
        "task_name": { "type": "string", "required": false, "description": "FAIRChem UMA task head such as omat or oc20; not the PToModel task key" },
        "checkpoint": { "type": "path_or_null", "required": false },
        "device": { "type": "enum", "required": false, "choices": ["cuda", "cpu"] },
        "placement_mode": { "type": "enum", "required": false, "choices": ["cell", "active"] },
        "active_symbols": { "type": "string_list", "required": false },
        "site_radius": { "type": "float", "required": false },
        "z_min": { "type": "float", "required": false },
        "z_max": { "type": "float", "required": false },
        "detach_cutoff": { "type": "float", "required": false },
        "penalty_energy": { "type": "float", "required": false },
        "max_steps": { "type": "int", "required": false },
        "include_d3": { "type": "bool", "required": false },
        "candidate_pool_size": { "type": "int", "required": false },
        "selection_count": { "type": "int", "required": false },
        "top_pool_size": { "type": "int", "required": false },
        "top_pick_count": { "type": "int", "required": false },
        "tail_bin_size": { "type": "int", "required": false },
        "tail_pick_per_bin": { "type": "int", "required": false },
        "selection_random_seed": { "type": "int", "required": false }
      },
      "constraints": [
        "placement_mode in ['cell', 'active']",
        "placement_mode='active' requires active_symbols",
        "this task requires fairchem-core, torch, and a usable UMA model"
      ]
    },
    "sam_functionalization": {
      "script": "genkai.modeling.surface.sam:main",
      "ptomodel_mapping_role": "molecular self-assembled monolayer anchored to a slab",
      "parameters": {
        "surface": { "type": "path", "required": false, "description": "Slab file; one of surface or bulk" },
        "bulk": { "type": "path", "required": false, "description": "Bulk crystal cut into the slab" },
        "facet": { "type": "string", "required": false },
        "molecule": { "type": "path", "required": true, "description": "3D structure of the SAM molecule" },
        "binding_mode": { "type": "string", "required": true, "description": "phosphonic: monodentate|bidentate|tridentate; carboxylic: monodentate|bidentate; thiol: top|bridge|hollow|fcc|hcp" },
        "counts": { "type": "comma_separated_ints", "required": false, "description": "Molecules per cell, one frame per count" },
        "density": { "type": "float", "required": false, "description": "Molecules per nm^2; alternative to counts" },
        "anchor_kind": { "type": "string", "required": false, "description": "phosphonic, carboxylic or thiol" },
        "acidic_h": { "type": "string", "required": false },
        "tilt": { "type": "float", "required": false },
        "seed": { "type": "int", "required": false },
        "output_dir": { "type": "path", "required": false }
      },
      "constraints": [
        "exactly one of counts or density",
        "binding_mode must suit the anchor group",
        "structure-only: no energy model"
      ]
    },
    "ald_overlayer": {
      "script": "genkai.modeling.surface.amorphous_overlayer:main",
      "ptomodel_mapping_role": "ALD amorphous overlayer (continuous film or island) on a crystal slab",
      "parameters": {
        "surface": { "type": "path", "required": false, "description": "Slab file; one of surface or bulk" },
        "bulk": { "type": "path", "required": false, "description": "Bulk crystal cut into the slab" },
        "facet": { "type": "string", "required": false },
        "amorphous": { "type": "path", "required": true, "description": "Periodic amorphous bulk cell of the overlayer" },
        "coverage": { "type": "string", "required": true, "description": "full (film) or partial (island)" },
        "thickness": { "type": "float", "required": false, "description": "Film thickness in angstrom (full coverage)" },
        "island_atoms": { "type": "int", "required": false, "description": "Island size (partial coverage)" },
        "island_radius": { "type": "float", "required": false },
        "film_fit": { "type": "string", "required": false },
        "samples": { "type": "int", "required": false },
        "seed": { "type": "int", "required": false },
        "output_dir": { "type": "path", "required": false }
      },
      "constraints": [
        "coverage='full' requires thickness",
        "coverage='partial' requires exactly one of island_atoms or island_radius",
        "structure-only: no energy model"
      ]
    },
    "amorphous_slab": {
      "script": "genkai.modeling.surface.amorphous_slab:main",
      "ptomodel_mapping_role": "pure amorphous surface cut from an amorphous bulk cell",
      "parameters": {
        "amorphous": { "type": "path", "required": true, "description": "Periodic amorphous bulk cell" },
        "thickness": { "type": "float", "required": true, "description": "Slab thickness in angstrom" },
        "vacuum": { "type": "float", "required": false },
        "repeat_xy": { "type": "comma_separated_ints", "required": false },
        "fixed_fraction": { "type": "float", "required": false },
        "samples": { "type": "int", "required": false },
        "seed": { "type": "int", "required": false },
        "output_dir": { "type": "path", "required": false }
      },
      "constraints": [
        "only windows that need no atom removal are kept",
        "structure-only: no energy model"
      ]
    }
  }
}
